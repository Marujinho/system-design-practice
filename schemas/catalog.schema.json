{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "services": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z0-9-]+$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "entry",
              "dns",
              "cdn",
              "api-gateway",
              "load-balancer",
              "nat",
              "waf",
              "compute",
              "function",
              "object-storage",
              "kv-database",
              "sql-database",
              "cache",
              "queue",
              "pubsub",
              "stream",
              "search",
              "observability"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "entrada",
              "rede",
              "computacao",
              "dados",
              "cache",
              "mensageria",
              "busca",
              "observabilidade"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "429",
              "503",
              "throttle",
              "none"
            ]
          },
          "validTargetKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "entry",
                "dns",
                "cdn",
                "api-gateway",
                "load-balancer",
                "nat",
                "waf",
                "compute",
                "function",
                "object-storage",
                "kv-database",
                "sql-database",
                "cache",
                "queue",
                "pubsub",
                "stream",
                "search",
                "observability"
              ]
            }
          },
          "variants": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "capPerUnit": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "capSource": {
                  "type": "string",
                  "enum": [
                    "aws-quota",
                    "assumption"
                  ]
                },
                "capSourceUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "baseLatencyMs": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "burst": {
                  "type": "boolean"
                },
                "family": {
                  "type": "string",
                  "enum": [
                    "burst",
                    "general",
                    "compute",
                    "memory"
                  ]
                },
                "prices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "amountUsd": {
                        "type": "number",
                        "minimum": 0
                      },
                      "per": {
                        "type": "string",
                        "enum": [
                          "unit-hour",
                          "unit-month",
                          "million-requests",
                          "gb",
                          "gb-second",
                          "capacity-unit-hour"
                        ]
                      },
                      "priceDate": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      "sourceUrl": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "amountUsd",
                      "per",
                      "priceDate",
                      "sourceUrl"
                    ],
                    "additionalProperties": false
                  }
                },
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "aws-quota",
                          "assumption"
                        ]
                      },
                      "sourceUrl": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "value",
                      "unit",
                      "source"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "label",
                "capPerUnit",
                "capSource",
                "baseLatencyMs",
                "prices",
                "limits"
              ],
              "additionalProperties": false
            }
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "default": {
                  "type": "number"
                }
              },
              "required": [
                "key",
                "label",
                "unit",
                "min",
                "max",
                "step",
                "default"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "provider",
          "kind",
          "category",
          "label",
          "description",
          "errorCode",
          "validTargetKinds",
          "variants",
          "params"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "catalogVersion",
    "services"
  ],
  "additionalProperties": false
}
