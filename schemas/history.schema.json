{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problemId": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "stars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "belowReference": {
            "type": "boolean"
          },
          "solutionSeen": {
            "type": "boolean"
          }
        },
        "required": [
          "problemId",
          "at",
          "score",
          "stars",
          "cost",
          "belowReference",
          "solutionSeen"
        ],
        "additionalProperties": false
      }
    },
    "solutionViewedAt": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "attempts",
    "solutionViewedAt"
  ],
  "additionalProperties": false
}
