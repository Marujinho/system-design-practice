{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "problemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "type": "string",
      "const": "ready"
    },
    "readyAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "diagram": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "catalogVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "nodes": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "serviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "variantId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "props": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 32
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "overrides": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 32
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "required": [
              "id",
              "serviceId",
              "variantId",
              "position",
              "label",
              "props",
              "overrides"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "maxItems": 400,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "http",
                  "grpc",
                  "tcp",
                  "websocket",
                  "pubsub",
                  "queue"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "classes": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                }
              }
            },
            "required": [
              "id",
              "source",
              "target",
              "protocol"
            ],
            "additionalProperties": false
          }
        },
        "load": {
          "type": "object",
          "properties": {
            "classes": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "users",
                      "rps",
                      "rpm"
                    ]
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "read",
                      "write"
                    ]
                  },
                  "users": {
                    "type": "number",
                    "minimum": 0
                  },
                  "reqPerUserPerMin": {
                    "type": "number",
                    "minimum": 0
                  },
                  "rps": {
                    "type": "number",
                    "minimum": 0
                  },
                  "rpm": {
                    "type": "number",
                    "minimum": 0
                  },
                  "payloadKB": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1048576
                  },
                  "cacheable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "mode",
                  "op",
                  "payloadKB",
                  "cacheable"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "classes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "catalogVersion",
        "nodes",
        "edges",
        "load"
      ],
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "properties": {
        "global": {
          "type": "object",
          "properties": {
            "rpsIn": {
              "type": "number"
            },
            "errorRps": {
              "type": "number"
            },
            "errorRate": {
              "type": "number"
            },
            "costMonth": {
              "type": "number"
            },
            "p50ByClass": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "p99ByClass": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "throughputByClass": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "bottleneckId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "rpsIn",
            "errorRps",
            "errorRate",
            "costMonth",
            "p50ByClass",
            "p99ByClass",
            "throughputByClass",
            "bottleneckId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "global"
      ],
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stars": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ]
        },
        "parts": {
          "type": "object",
          "properties": {
            "requirements": {
              "type": "number"
            },
            "cost": {
              "type": "number"
            },
            "headroom": {
              "type": "number"
            }
          },
          "required": [
            "requirements",
            "cost",
            "headroom"
          ],
          "additionalProperties": false
        },
        "allPass": {
          "type": "boolean"
        },
        "passAt15": {
          "type": "boolean"
        },
        "passAt2": {
          "type": "boolean"
        },
        "userCost": {
          "type": "number"
        },
        "referenceCost": {
          "type": "number"
        },
        "belowReference": {
          "type": "boolean"
        },
        "solutionSeen": {
          "type": "boolean"
        }
      },
      "required": [
        "total",
        "stars",
        "parts",
        "allPass",
        "passAt15",
        "passAt2",
        "userCost",
        "referenceCost",
        "belowReference",
        "solutionSeen"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "metric": {
            "type": "string",
            "enum": [
              "throughput",
              "p99",
              "errorRate",
              "costMonth",
              "queueAge",
              "queueStable"
            ]
          },
          "class": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "<=",
              ">="
            ]
          },
          "measured": {
            "type": "number"
          },
          "target": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "metric",
          "op",
          "measured",
          "target",
          "unit",
          "pass"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "bottleneck",
              "requirement-failed",
              "overprovisioned",
              "no-traffic",
              "invalid-connection",
              "breaks-under-load"
            ]
          },
          "nodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "numbers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "impact": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "nodeIds",
          "message",
          "numbers",
          "impact"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "problemId",
    "status",
    "readyAt",
    "diagram",
    "simulation",
    "score",
    "requirements",
    "findings"
  ],
  "additionalProperties": false
}
