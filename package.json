{
  "name": "archsim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @archsim/app dev",
    "preview": "pnpm --filter @archsim/app preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && turbo run typecheck",
    "test": "vitest run",
    "test:bench": "vitest run perf --reporter=verbose",
    "test:e2e": "pnpm --filter @archsim/app test:e2e",
    "archsim": "tsx packages/cli/src/index.ts",
    "audit": "pnpm audit --prod --audit-level high",
    "format": "prettier --write .",
    "schemas": "tsx scripts/export-schemas.ts"
  },
  "devDependencies": {
    "@archsim/catalog": "workspace:*",
    "@archsim/problems": "workspace:*",
    "@archsim/sim-engine": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
